      "parameters": {
        "jsCode": "const p = $json.body || $json;\nconst required = ['title', 'property_type', 'listing_type'];\nconst missing = required.filter((key) => !p[key]);\nif (missing.length) throw new Error(`Missing required fields: ${missing.join(', ')}`);\nconst embeddingContent = [p.title, p.short_description, p.full_description, p.visual_description, (p.nearby_references || []).join(' ')].filter(Boolean).join('\\n');\nreturn [{ json: { property: p, embedding_content: embeddingContent } }];"
      },
