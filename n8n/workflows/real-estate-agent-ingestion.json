{
  "name": "Real Estate Agent Ingestion",
  "nodes": [
    {
      "parameters": {"httpMethod": "POST", "path": "real-estate-agent/ingest-property", "responseMode": "responseNode", "options": {}},
      "id": "ingestion-webhook",
      "name": "Property Ingestion Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const p = $json.body || $json;\nconst required = ['title', 'property_type', 'listing_type'];\nconst missing = required.filter((key) => !p[key]);\nif (missing.length) throw new Error(`Missing required fields: ${missing.join(', ')}`);\nconst embeddingContent = [p.title, p.short_description, p.full_description, p.visual_description, (p.nearby_references || []).join(' ')].filter(Boolean).join('\\n');\nreturn [{ json: { property: p, embedding_content: embeddingContent } }];"
      },
      "id": "validate-property",
      "name": "Validate Property",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/properties",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json.property}}",
        "options": {}
      },
      "id": "upsert-property",
      "name": "Create or Update Property",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [480, 0],
      "credentials": {"httpHeaderAuth": {"id": "SUPABASE_HTTP_HEADER_AUTH", "name": "Supabase Real Estate REST"}}
    },
    {
      "parameters": {"respondWith": "json", "responseBody": "={\"ok\": true, \"message\": \"Property validated and sent to Supabase\"}"},
      "id": "ingestion-response",
      "name": "Ingestion Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [720, 0]
    }
  ],
  "connections": {
    "Property Ingestion Webhook": {"main": [[{"node": "Validate Property", "type": "main", "index": 0}]]},
    "Validate Property": {"main": [[{"node": "Create or Update Property", "type": "main", "index": 0}]]},
    "Create or Update Property": {"main": [[{"node": "Ingestion Response", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"},
  "active": false
}
