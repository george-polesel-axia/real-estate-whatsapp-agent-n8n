      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst summary = `Cliente: ${body.client?.name || 'sem nome'} (${body.client?.phone || body.phone || 'telefone nao informado'}). Intencao: ${body.intent || 'handoff'}. Imovel provavel: ${body.property?.title || 'nao definido'}. Ultima mensagem: ${body.last_message || ''}`;\nconst clientReply = 'Claro, vou pedir para um corretor chamar voce em poucos minutos. Enquanto isso, ja posso tentar deixar uma visita pre-agendada: prefere sabado pela manha ou domingo as 14h?';\nreturn [{ json: { ...body, broker_summary: summary, client_reply: clientReply, handoff_status: 'open' } }];"
